{
  "private": true,
  "name": "atelier-lecture",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:tablet": "npm run dev --workspace apps/tablet",
    "dev:server": "npm run dev --workspace apps/server",
    "build:tablet": "npm run build --workspace apps/tablet",
    "build:server": "npm run build --workspace apps/server",
    "build:all": "npm run build:tablet && npm run build:server",
    "start": "npm run start --workspace apps/server",
    "seed:students": "npm run seed:students --workspace apps/server",
    "cert": "node scripts/generate-certificate.mjs"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "selfsigned": "^5.5.0"
  }
}
