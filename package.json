{
  "private": true,
  "name": "atelier-lecture",
  "version": "0.1.0",
  "scripts": {
    "dev:tablet": "pnpm --filter tablet run dev",
    "dev:server": "pnpm --filter server run dev",
    "build:tablet": "pnpm --filter tablet run build",
    "build:server": "pnpm --filter server run build",
    "build:all": "pnpm run build:tablet && pnpm run build:server",
    "start": "pnpm --filter server run start",
    "cert": "pnpm --filter server run cert",
    "backup": "pnpm --filter server run backup",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1"
  },
  "packageManager": "pnpm@12.15.0"
}
